# Space AKIRA-SOFTEDGE para as respostas de chat.
AKIRA_CHAT_SPACE_ID=akra35567/AKIRA-SOFTEDGE
# Space AKIRAGPU para geração e análise de imagens.
HF_SPACE_ID=akra35567/Akiragpu
# URL pública usada nas pré-visualizações de links (Open Graph e Twitter).
NEXT_PUBLIC_SITE_URL=https://akira-ia.onrender.com
# Token Hugging Face (opcional; apenas no servidor, nunca no browser).
HF_TOKEN=
# PostgreSQL persistente necessário para quotas, assinaturas e links partilhados.
DATABASE_URL=
# Segredo aleatório com pelo menos 32 caracteres para assinar o cookie de faturação.
BILLING_COOKIE_SECRET=
# Stripe (chaves privadas, nunca expor ao browser).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs de preços recorrentes mensais em USD 5 e USD 12, respetivamente.
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTRA=
